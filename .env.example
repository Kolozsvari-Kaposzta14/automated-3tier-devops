# Example only: copy to .env and replace every CHANGE_ME value.
# Do not commit real passwords or credentials to Git.
POSTGRES_DB=tasks
POSTGRES_USER=tasks_app
POSTGRES_PASSWORD=CHANGE_ME_USE_A_STRONG_RANDOM_PASSWORD
# These are separate local endpoints planned for future Compose stacks.
STAGING_HTTP_PORT=8080
PRODUCTION_HTTP_PORT=8081
# AWS configuration will be supplied to the publishing workflow in Phase 5.
AWS_REGION=eu-central-1
ECR_FRONTEND_REPOSITORY=three-tier-frontend
ECR_BACKEND_REPOSITORY=three-tier-backend
