# Primary application environment configuration.
#
# Store actual credentials outside the Git repository:
# ~/.config/automated-3tier-devops/primary.env
#
# Private directory permissions: 700
# Private environment file permissions: 600
#
# Supply the private environment file to Docker Compose
# using the --env-file option.
#
# Never commit actual credentials.


# ==================================================
# Automated Lifecycle for Three-Tier Web Applications
# Environment Configuration Template
# ==================================================

# Copy this template to .env when configuring a new environment.
# Replace every CHANGE_ME value before starting the application.
# Never commit actual passwords or credentials to Git.


# --------------------------------------------------
# PostgreSQL Database Configuration
# --------------------------------------------------

# Database name used by the Kanban application.
POSTGRES_DB=taskmanager

# Database user used by the FastAPI backend.
POSTGRES_USER=taskapp

# Use a strong, randomly generated alphanumeric password
# to avoid database connection URL parsing issues.
POSTGRES_PASSWORD=CHANGE_ME_USE_A_STRONG_RANDOM_PASSWORD


# --------------------------------------------------
# Deployment Environment Configuration
# --------------------------------------------------

# HTTP port for the local staging environment.
STAGING_HTTP_PORT=8080

# HTTP port for the future production environment.
PRODUCTION_HTTP_PORT=8081


# --------------------------------------------------
# AWS and Elastic Container Registry Configuration
# --------------------------------------------------

# AWS region planned for container image publishing.
AWS_REGION=eu-central-1

# ECR repository for the React frontend Docker image.
ECR_FRONTEND_REPOSITORY=three-tier-frontend

# ECR repository for the FastAPI backend Docker image.
ECR_BACKEND_REPOSITORY=three-tier-backend
