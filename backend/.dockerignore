# =========================================================
# Backend Docker build context exclusions
# =========================================================

# Python virtual environments.
**/.venv/
**/venv/

# Python bytecode and interpreter caches.
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.pyd

# Development and testing artifacts.
**/.pytest_cache/
**/.ruff_cache/
**/.mypy_cache/
**/.coverage
**/.coverage.*
**/htmlcov/
**/coverage.xml
tests/
requirements-dev.txt

# Environment variables and local credentials.
**/.env
**/.env.*
**/.aws/
**/.ssh/
**/credentials
**/*.pem
**/*.key
**/*.p12
**/*.pfx

# Temporary backups and archives.
**/*.backup
**/*.bak
**/*.swp
**/*.tmp
**/*.log
**/*.zip
**/*.tar
**/*.tar.gz

# Version control and editor configuration.
**/.git/
**/.vscode/
**/.idea/
**/.DS_Store
**/Thumbs.db
