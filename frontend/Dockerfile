
# Stage 1: Build the React application.
# Node.js 24 matches our frontend development environment.
FROM node:24-alpine AS build

WORKDIR /app

# Copy dependency manifests first to benefit from Docker caching.
COPY package*.json ./

# Install exactly the dependencies recorded in package-lock.json.
RUN npm ci

# Copy the frontend source code.
COPY . .

# Compile TypeScript and generate production assets.
RUN npm run build


# Stage 2: Serve the compiled frontend with Nginx.
# The final image does not need Node.js or development dependencies.
FROM nginx:stable-alpine

# Copy the production assets generated by Vite.
COPY --from=build /app/dist /usr/share/nginx/html

# Nginx listens on port 80 inside the container.
EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
