# Legacy standalone PostgreSQL development environment.
#
# Store the actual environment file outside the repository:
# ~/.config/automated-3tier-devops/legacy.env
#
# Restrict the private directory to permissions 700
# and the private environment file to permissions 600.
#
# Supply the private file to Docker Compose using --env-file.
# Replace the placeholder with a strong, unique password.
# Never commit actual credentials.

LEGACY_POSTGRES_PASSWORD=CHANGE_ME_USE_A_STRONG_RANDOM_PASSWORD
